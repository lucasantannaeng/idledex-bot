# Virtual environment & cache
__pycache__/
*.pyc
*.bak
build/*
!build/icon.ico
!build/icon.png
dist/
dist-desktop/
dist-candidate/
dist-release/
.smoke-profile/
research/*.js
!research/*.cjs
research/play.html
research/play-current.html
research/previous-runtime/
node_modules/
*.log
_agy_prompt.txt

# Unignore electron project sources (overriding global .gitignore)
!electron/
!electron/**

# =============================================================================
# DevSecOps: Desktop Compilations, Binaries & Secret Protection (Zero-Trust)
# =============================================================================
.env
.env.*
!.env.example
*.secret
*.key
*.pem
*.cert
credentials.json
config.json
!config.example.json

# Binaries & Packaging Outputs
*.exe
*.dll
*.asar
*.dmg
*.apk
*.aab
*.msi
*.zip
*.7z
*.tar.gz

