{
  "name": "idledex-desktop",
  "version": "2.4.0",
  "description": "IdleDex Desktop App with Built-in Chromium and Autonomous Bot",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --dir"
  },
  "build": {
    "appId": "com.idledex.desktop",
    "productName": "IdleDex Desktop",
    "directories": {
      "output": "dist-desktop"
    },
    "win": {
      "target": "dir"
    },
    "asar": false,
    "files": [
      "electron/**/*",
      "app/**/*",
      "package.json"
    ]
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}
